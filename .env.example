# Optional explicit League installation folder for development.
SUMMONERKIT_LEAGUE_PATH=C:\Riot Games\League of Legends

# Optional bridge override. Defaults to 127.0.0.1:17654.
SUMMONERKIT_BRIDGE_PORT=17654

# v2 mobile relay. Set this as a Cloudflare Worker secret, never in source.
PAIRING_ADMIN_SECRET=replace-in-wrangler-secret-store
MOBILE_ORIGIN=http://localhost:5173

# Desktop-to-mobile pairing. This value must match the Worker secret above.
SUMMONERKIT_RELAY_URL=http://127.0.0.1:8787
SUMMONERKIT_MOBILE_URL=http://127.0.0.1:5173
SUMMONERKIT_RELAY_ADMIN_SECRET=replace-with-the-same-32-character-secret

# Optional approved online rune recommendation feed. Public releases should
# keep Riot API credentials in the feed backend, never in this desktop app.
SUMMONERKIT_BUILD_DATA_URL=https://mohamedmagdy2208.github.io/SummonerKit/data/runes-v1.json
# Optional bearer token for a private feed. This remains in the Electron main process.
SUMMONERKIT_BUILD_DATA_TOKEN=replace-with-a-feed-token

# Server-side rune feed publisher. RIOT_API_KEY belongs only in a local or
# GitHub secret store and must never be added to this file with a real value.
RIOT_API_KEY=RGAPI-replace-only-in-your-secret-store
RIOT_PLATFORMS=EUW1,KR
RIOT_MAX_PLAYERS_PER_PLATFORM=24
RIOT_MATCHES_PER_PLAYER=6
RIOT_LOOKBACK_DAYS=14
RIOT_REQUEST_INTERVAL_MS=1300
SUMMONERKIT_FEED_OUTPUT=apps/mobile/dist/data/runes-v1.json
SUMMONERKIT_FEED_PROVIDER_NAME=SummonerKit approved Riot aggregation
SUMMONERKIT_MAX_FEED_AGE_HOURS=48
# Optional curated patch entries added to schema-v2 output. Keep sourceUrl HTTPS.
SUMMONERKIT_PATCH_IMPACTS_JSON=[]
